GRANT_INCOMPLETE_PROJECT_HTML_URI=

# Runtime IDs.
GRANT_ROUND_ID=
GRANT_APPLICATION_ID=
GRANT_APPLICATION_IDS=
GRANT_APPLICANT_INDEX=

# Optional hash/notes/recipients.
GRANT_EVIDENCE_HASH=
GRANT_NOTES_URI=
GRANT_REFUND_RECIPIENT=
GRANT_PRIZE_RECIPIENT=

# Somnia testnet smoke transactions have needed a high explicit gas cap in live testing.
DEMO_GAS_LIMIT=10000000
DEMO_CALL_GAS_LIMIT=10000000

# v0.2.0 canary runner inputs.
CANARY_ACTION=
CANARY_REQUEST_ID=
