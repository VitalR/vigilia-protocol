SOMNIA_CHAIN_ID=50312
SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network/
SOMNIA_WS_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_BLOCK_EXPLORER=https://shannon-explorer.somnia.network/
SOMNIA_BLOCKSCOUT_API=https://somnia.w3us.site/api/

# Must be a contract address, not the Agent Explorer URL.
SOMNIA_AGENT_PLATFORM=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776
SOMNIA_AGENT_EXPLORER_URL=https://agents.testnet.somnia.network/

# Active agent used by v0.1.0 JSON API smoke deployment.
# For v0.1.0, SOMNIA_AGENT_ID should equal SOMNIA_JSON_API_AGENT_ID.
# Do not use LLM agent IDs with VigiliaJsonApiVerifier.
SOMNIA_AGENT_ID=13174292974160097713
SOMNIA_AGENT_TYPE=json-api-request
VIGILIA_DEPLOYMENT_NAME=vigilia-json-api-smoke
VIGILIA_VERSION=v0.1.0

# Known Somnia base agent references for future v0.2.0 work.
SOMNIA_JSON_API_AGENT_ID=13174292974160097713
SOMNIA_LLM_INFERENCE_AGENT_ID=12847293847561029384
SOMNIA_LLM_WEB_AGENT_ID=12875401142070969085
SOMNIA_LLM_PARSE_WEBSITE_AGENT_ID=12875401142070969085

SOMNIA_VERDICT_SELECTOR=verdict

# AGENT_SUBCOMMITTEE_SIZE should match the intended createRequest/default platform behavior.
AGENT_SUBCOMMITTEE_SIZE=3

# Denominated in wei.
AGENT_PRICE_PER_VALIDATOR=30000000000000000
AGENT_PLATFORM_RESERVE_WEI=30000000000000000
JSON_API_PRICE_PER_VALIDATOR_WEI=30000000000000000
LLM_INFERENCE_PRICE_PER_VALIDATOR_WEI=70000000000000000
LLM_PARSE_PRICE_PER_VALIDATOR_WEI=100000000000000000

# Deployed v0.1.0 JSON API smoke contracts.
