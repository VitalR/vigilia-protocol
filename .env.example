DEMO_ACTION=
DEMO_TASK_ID=
DEMO_CONTRACTOR=
DEMO_RESOLVER=

# 300 seconds is short enough for live demo review-window testing.
DEMO_REVIEW_WINDOW=300
DEMO_TASK_AMOUNT_WEI=100000000000000000
# 0 = ClientApprovalOnly, 1 = ReviewWindowAutoClaim, 2 = ImmediateAutoClaim.
DEMO_CLAIM_POLICY=1
DEMO_PARENT_REQUEST_ID=

# JSON-only smoke deposit for v0.1.0 VigiliaJsonApiVerifier demos.
AGENT_REQUEST_DEPOSIT_WEI=120000000000000000
# Two-agent settlement submit/retry deposit for JsonFactsToLlmVerdict (JSON 0.12 STT + LLM 0.24 STT).
TWO_AGENT_WORKFLOW_DEPOSIT_WEI=360000000000000000
# GrantRound requestApplicationScreening deposit for ScreeningMode.TwoAgent.
GRANT_ROUND_WORKFLOW_DEPOSIT_WEI=360000000000000000

# GrantRound demo config.
GRANT_SCREENING_MODE=0
GRANT_PRIZE_AMOUNT_WEI=1000000000000000000
GRANT_MAX_WINNERS=3
GRANT_APPLICATION_WINDOW_SECONDS=300
GRANT_REVIEW_WINDOW_SECONDS=600
GRANT_FAST_DEADLINES=false
GRANT_FAST_APPLICATION_WINDOW_SECONDS=300
GRANT_FAST_REVIEW_WINDOW_SECONDS=900
GRANT_REQUIREMENTS_URI=https://raw.githubusercontent.com/<org>/<repo>/<branch>/demo/evidence/grants/grant-requirements.md

# Public evidence URLs. Local fixtures under demo/evidence/grants are examples only.
GRANT_EVIDENCE_URI=
