JSON_CANARY_SELECTOR=verdict
LLM_CANARY_PROMPT=The milestone is complete. Return exactly one allowed value.
LLM_CANARY_SYSTEM=You are a strict Vigilia verifier. Return only one allowed value.
LLM_CANARY_CHAIN_OF_THOUGHT=false
WEBSITE_CANARY_URL=https://example.com/
WEBSITE_CANARY_INSTRUCTION=Return exactly one of these words after reading the page: Complete, NeedsReview, Incomplete.
